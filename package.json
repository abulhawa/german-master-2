{
  "name": "german-master-2",
  "version": "0.0.0",
  "private": true,
  "description": "German Master web and native Android monorepo",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/web",
    "contracts",
    "packages/learning-engine",
    "services/api"
  ],
  "scripts": {
    "content:review": "tsx services/api/scripts/review-content.ts",
    "content:prepare-basics": "tsx services/api/scripts/prepare-basic-content.ts",
    "content:preview-basics": "tsx services/api/scripts/preview-basic-content.ts",
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev:client --workspace=apps/web",
    "check": "npm run check:generated && npm run check --workspace=apps/web && npm run check:backend",
    "test": "npm run test:backend && npm test --workspace=apps/web && npm run test:web-http",
    "test:web-http": "vitest run --config vitest.web-http.config.ts",
    "build": "npm run build --workspace=apps/web && npm run build --workspace=services/api && npm run build:production-api",
    "build:production-api": "esbuild services/api/src/production-host.ts --bundle --platform=node --format=esm --external:pg --external:@supabase/supabase-js --outfile=services/api/dist/production-host.mjs",
    "build:production": "npm run build:learner-product && npm run build:production-api",
    "check:web": "npm run check --workspace=apps/web",
    "test:web": "npm test --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:learner-preview": "npm run build:learner-preview --workspace=apps/web",
    "build:learner-product": "npm run build:learner-product --workspace=apps/web",
    "preview:learner": "npm run preview:learner --workspace=apps/web",
    "test:offline-shell": "npm run test:offline-shell --workspace=apps/web",
    "generate:foundation": "node contracts/scripts/generate.mjs && node design/generate.mjs",
    "check:generated": "node contracts/scripts/generate.mjs --check && node design/generate.mjs --check",
    "check:backend": "tsc -p tsconfig.backend.json",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "dev:api": "npm run dev --workspace=services/api"
  },
  "overrides": {
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.28.1"
    },
    "@esbuild-kit/esm-loader@2.6.5": {
      "@esbuild-kit/core-utils": {
        "esbuild": "0.28.1"
      }
    },
    "serialize-javascript": "^7.0.5",
    "glob": "9.3.5",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@1.5.0",
    "@tailwindcss/typography@0.5.19": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
