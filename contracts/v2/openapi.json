{
  "openapi": "3.1.0",
  "info": {
    "title": "German Master foundation API",
    "version": "2.0.0-draft",
    "description": "Isolated foundation API. Local draft-content demonstration; production authentication and selection are not implemented."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v2/packs": {
      "post": {
        "operationId": "preparePack",
        "description": "Atomically allocate a reserve of two owned pinned sessions with offline rubrics. requestId replays the whole pack without renewing the seven-day new-start expiry. SHA-256 covers canonical JSON excluding contentHash. Late uploads from started sessions remain accepted; preparation grants no learning evidence. Unpublished local fixture only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/SessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete immutable pack or replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/PreparedPack"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Changed request or insufficient compatible content; captured subject mismatch (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/sessions/{sessionId}/complete": {
      "post": {
        "operationId": "completeSession",
        "description": "Freeze an owned full or partial completion receipt. Full requires an accepted answer or Skip for every question. Partial ends new submissions; accepted writes still replay. Counts come from server evidence; completion never grants learning credit. Same requestId, session and payload replay identically; changes conflict.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/SessionCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Frozen receipt or replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/SessionCompletionReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Owned session unavailable"
          },
          "409": {
            "description": "Incomplete full session or completion conflict; captured subject mismatch (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/content-reports": {
      "post": {
        "operationId": "reportContent",
        "description": "Record a category against an owned pinned exercise revision. Same reportId and payload replay identically; changes conflict. New reports limited to ten per learner per rolling hour in the local adapter. No answer text is uploaded and learning evidence is unchanged.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/ContentReportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ContentReportReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Owned question unavailable"
          },
          "409": {
            "description": "Revision mismatch or report conflict; captured subject mismatch (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "New-report rate limit; explicit later retry"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/sessions": {
      "post": {
        "operationId": "createSession",
        "description": "Select owned questions compatible with declared capabilities; pin immutable revisions. requestId is replay-safe; changed payload conflicts. Solutions are omitted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SessionRequest"
                  },
                  {
                    "$ref": "#/components/schemas/FocusedSessionRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Ownership failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or capability conflict; captured subject mismatch (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/guest-attempts:attach": {
      "post": {
        "operationId": "attachGuestAttempts",
        "description": "Explicitly attach local guest attempts after authentication. The server validates published immutable release/exercise revisions, creates owned questions only for valid items, grades again server-side, and uses attemptId for replay safety. Invalid or stale revisions are returned as item-level rejections and remain local.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestAttachmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptBatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Ownership failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or capability conflict; captured subject mismatch (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/attempts:batch": {
      "post": {
        "operationId": "submitAttempts",
        "description": "Server derives owner from bearer token. Up to 50 attempts. Each item commits independently. Same attemptId and payload returns original acknowledgment; changed payload conflicts. Never accept a client grade. Rejections preserve batch ordering.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptBatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Ownership failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or capability conflict; captured subject mismatch (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/exposures:batch": {
      "post": {
        "operationId": "submitExposures",
        "description": "Owned replay-safe exposure or terminal skip events. Exposure does not finish a question; skip finishes it without grading. Neither advances mastery. Each accepted item atomically saves evidence, projection, schedule and sync change.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExposureBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExposureBatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Ownership failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or capability conflict; captured subject mismatch (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/targets": {
      "get": {
        "operationId": "getTargets",
        "description": "Confirmed target summaries at a frozen UTC instant and sync watermark. Follow nextPageCursor with cursor; empty string ends pagination. Persist all pages before using syncCursor. A fresh snapshot refreshes due eligibility.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmed owned page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, cursor or authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid request, cursor or authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Captured subject does not match the authenticated account (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/sync": {
      "get": {
        "operationId": "getSync",
        "description": "Owned ordered ingestion-time target upserts after an opaque cursor. Omitted cursor starts at zero. Reuse nextCursor until hasMore is false; commit changes locally before advancing. Due flags retain ingestion-time meaning; refresh targets or compare UTC deadlines for current eligibility.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmed owned page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, cursor or authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid request, cursor or authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Captured subject does not match the authenticated account (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/catalog": {
      "get": {
        "operationId": "readLocalDraftCatalog",
        "description": "Authenticated solution-free metadata for the isolated unpublished foundation release. Not a production publication endpoint. No query parameters.",
        "responses": {
          "200": {
            "description": "Draft catalog metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported query"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Captured subject does not match the authenticated account (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/profile": {
      "get": {
        "operationId": "readOwnedProfile",
        "description": "Owned saved preferences. Reads create a default unconfigured local fixture profile. No learner identity is exposed.",
        "responses": {
          "200": {
            "description": "Current profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/LearnerProfile"
                }
              }
            }
          },
          "409": {
            "description": "Captured subject does not match the authenticated account (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "saveOwnedProfile",
        "description": "Revision-checked, request-ID replay-safe setup. Saved event timezones and existing sessions remain unchanged. Replays return the original response; refresh GET for latest state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/ProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/LearnerProfile"
                }
              }
            }
          },
          "400": {
            "description": "Invalid preferences or IANA timezone"
          },
          "409": {
            "description": "Changed replay payload or stale expected revision; captured subject mismatch (account_changed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/me/export": {
      "get": {
        "operationId": "exportLearner",
        "description": "Owned confirmed server data only. Unsynced local work is excluded; sync explicitly before export. No shared catalog rubrics or credentials.",
        "responses": {
          "200": {
            "description": "LearnerExport",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/LearnerExport"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "410": {
            "description": "Learner deleted"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    },
    "/v2/me": {
      "delete": {
        "operationId": "deleteLearner",
        "description": "Explicit owned-data deletion in the disposable local adapter. Frozen requestId retries after response loss return the original receipt. Retains only a subject/request/timestamp tombstone to refuse abandoned uploads. Does not delete host-auth identity; production requires reauthentication, auth revocation and reviewed retention policy before enabling.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/PrivacyDeleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PrivacyDeleteReceipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/PrivacyDeleteReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Deletion request conflict"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/LearnerSubject"
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Session": {
        "$ref": "./schema.json#/$defs/Session"
      },
      "SessionRequest": {
        "$ref": "./schema.json#/$defs/SessionRequest"
      },
      "AttemptBatch": {
        "$ref": "./schema.json#/$defs/AttemptBatch"
      },
      "AttemptBatchResponse": {
        "$ref": "./schema.json#/$defs/AttemptBatchResponse"
      },
      "ApiError": {
        "$ref": "./schema.json#/$defs/ApiError"
      },
      "ExposureBatch": {
        "$ref": "./schema.json#/$defs/ExposureBatch"
      },
      "ExposureBatchResponse": {
        "$ref": "./schema.json#/$defs/ExposureBatchResponse"
      },
      "TargetPage": {
        "$ref": "./schema.json#/$defs/TargetPage"
      },
      "SyncPage": {
        "$ref": "./schema.json#/$defs/SyncPage"
      },
      "FocusedSessionRequest": {
        "$ref": "./schema.json#/$defs/FocusedSessionRequest"
      },
      "Catalog": {
        "$ref": "./schema.json#/$defs/Catalog"
      },
      "GuestAttachmentRequest": {
        "$ref": "./schema.json#/$defs/GuestAttachmentRequest"
      }
    },
    "parameters": {
      "LearnerSubject": {
        "name": "X-Learner-Subject",
        "in": "header",
        "required": false,
        "description": "Captured subject for account-bound clients. If present it must match the verified authenticated subject; mismatch returns 409 account_changed before reads or request body ingestion. This header does not authenticate a caller. Isolated stateless fixture transports may omit it.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
