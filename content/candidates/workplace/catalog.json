      },
      "description": {
        "en": "Obwohl introduces a concession; the finite verb comes last.",
        "de": "Obwohl leitet einen Gegensatz ein; das finite Verb steht am Ende."
      },
      "level": "B2",
      "learningContext": "work"
    },
    {
      "id": "60000000-0000-4000-8000-000000000116",
      "topicId": "60000000-0000-4000-8000-000000000600",
      "title": {
        "en": "Relative pronouns",
        "de": "Relativpronomen"
